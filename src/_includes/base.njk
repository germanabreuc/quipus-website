<!doctype html>
<html lang="es" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} · Quipus</title>
  <meta name="description" content="{{ description or 'Quipus — Action Tank de comunicación para marcas orientadas a audiencias hispanas.' }}">
  {% if noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght,ital@9..144,380..600,0;9..144,380..600,1&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/style.css">
  <link rel="icon" href="/assets/img/logos/quipus-isotipo-blanco.png" media="(prefers-color-scheme: dark)">
</head>
<body>
  <a class="visually-hidden" href="#main">Saltar al contenido</a>

  <header class="site-header">
    <div class="container site-header__inner">
      <a class="site-header__logo" href="/" aria-label="Quipus — inicio">
        <img src="/assets/img/logos/quipus-imagotipo-negro.png" alt="Quipus">
      </a>
      <nav class="site-nav" aria-label="Principal">
        <ul class="site-nav__links">
          <li><a href="/" {% if page.url == "/" %}aria-current="page"{% endif %}>Quipus</a></li>
          <li><a href="/recursos/" {% if page.url == "/recursos/" %}aria-current="page"{% endif %}>Recursos</a></li>
        </ul>
        <a class="btn btn--primary" href="/hablemos/">Hablemos</a>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container site-footer__inner">
      <img src="/assets/img/logos/quipus-imagotipo-negro.png" alt="Quipus" style="height:22px;">
      <span>&copy; {% year %} Quipus. Todos los derechos reservados.</span>
      <div class="site-footer__right">
        <a href="/hablemos/">hola@quipusmx.com</a>
        <div class="site-footer__social">
          <a href="https://www.instagram.com/quipusmx" class="social-btn" aria-label="Quipus en Instagram" target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"/></svg>
          </a>
          <a href="https://www.linkedin.com/company/quipusmx/" class="social-btn" aria-label="Quipus en LinkedIn" target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.5 8h4V23h-4V8zm7 0h3.84v2.05h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.77 2.65 4.77 6.1V23h-4v-6.9c0-1.65-.03-3.77-2.3-3.77-2.3 0-2.66 1.8-2.66 3.65V23h-4V8z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </footer>
</body>
</html>
